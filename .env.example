PORT=3000

# MongoDB Atlas - cadena de conexion de tu cluster
MONGODB_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/asesor-inversion-pyme

# Secreto para firmar los JWT (cualquier string largo y aleatorio)
JWT_SECRET=cambiar-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# API Key de Google AI Studio (Gemini) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
